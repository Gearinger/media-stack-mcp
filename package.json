{
  "name": "media-stack-mcp",
  "version": "0.1.0",
  "description": "Self-hosted search-and-download stack: Prowlarr + aria2 behind an MCP server and a web UI",
  "type": "module",
  "license": "MIT",
  "bin": {
    "media-stack-mcp": "src/mcp.mjs",
    "media-stack-web": "src/web/server.mjs"
  },
  "scripts": {
